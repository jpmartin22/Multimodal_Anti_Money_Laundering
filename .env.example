# ── AML Multimodal Detection — Environment Variables ─────────────────────────
# Copy this file to .env and fill in values for your environment.
# .env is git-ignored; never commit real credentials.

# ── MLflow ────────────────────────────────────────────────────────────────────
# Shared MLflow service (inside docker-compose network):
MLFLOW_TRACKING_URI=http://mlflow:5000
# If you run training from your host machine instead of Docker, use:
# MLFLOW_TRACKING_URI=http://localhost:5000
#
# Shared backend store + artifact root used by docker-compose mlflow service.
# Team note: one teammate runs `docker compose up mlflow -d`, everyone else
# points MLFLOW_TRACKING_URI to that machine/IP.
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow_change_me
MLFLOW_POSTGRES_DB=mlflow
# Optional override (docker-compose derives this automatically from vars above):
# MLFLOW_BACKEND_STORE_URI=postgresql://<user>:<password>@postgres:5432/<db_name>
MLFLOW_DEFAULT_ARTIFACT_ROOT=/app/mlruns

# ── Inference API ─────────────────────────────────────────────────────────────
# Risk score threshold above which a transaction is flagged
AML_THRESHOLD=0.5
PORT=8000

# ── Logging ───────────────────────────────────────────────────────────────────
# One of: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change_me_in_production
GF_USERS_ALLOW_SIGN_UP=false

# ── Python runtime ────────────────────────────────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
